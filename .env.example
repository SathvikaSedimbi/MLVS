# MLVS - Mine Low-Visibility Support System Configuration

# STM32 NUCLEO-F446RE Hardware Connection
COM_PORT=COM7
BAUD_RATE=115200
SERIAL_TIMEOUT=1.0

# Telemetry Database (PostgreSQL)
# Format: postgresql://<user>:<password>@localhost:5432/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mlvs_db

# Vehicle Identification
VEHICLE_ID=V-01

# Simulation Mode (false to use real STM32 hardware on COM7)
SIMULATION_MODE=false

# OLED Downlink
OLED_DOWNLINK_ENABLED=true
OLED_UPDATE_INTERVAL_SEC=0.5

# Safety Thresholds
CRITICAL_DISTANCE_CM=30.0
WARNING_DISTANCE_CM=60.0
BUFFER_DISTANCE_CM=100.0

CRITICAL_TTC_SEC=2.0
WARNING_TTC_SEC=4.0
